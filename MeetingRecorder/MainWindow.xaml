<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Meeting Recorder" Width="1180" Height="820" MinWidth="960" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F3F5F8" FontFamily="Segoe UI" Foreground="#182534">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CFD8E3"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="Background" Value="White"/></Style>
<Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4,0,8"/></Style>
</Window.Resources>
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="Meeting Recorder" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="A local Windows video recorder" Foreground="#607086" Margin="0,4,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock x:Name="StateLabel" Text="READY" FontWeight="Bold" Foreground="#176C61" HorizontalAlignment="Right"/><TextBlock x:Name="Clock" Text="00:00:00" FontSize="28" FontFamily="Consolas" HorizontalAlignment="Right"/></StackPanel></DockPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Setup">
<TextBlock Text="1   MEETING WINDOW" FontWeight="Bold" Foreground="#51647A"/>
<ComboBox x:Name="WindowPicker" DisplayMemberPath="Title"/>
<Button x:Name="Refresh" Content="Refresh windows and devices" HorizontalAlignment="Left" Margin="0,0,0,18"/>
<TextBlock Text="2   AUDIO" FontWeight="Bold" Foreground="#51647A"/>
<CheckBox x:Name="MeetingAudio" Content="Record meeting app audio" IsChecked="True" Margin="0,12,0,2"/>
<ComboBox x:Name="ProcessPicker" DisplayMemberPath="Label" IsTextSearchEnabled="True" TextSearch.TextPath="Label"/>
<TextBlock Text="Audio follows this app and its child processes. Browser capture may include other tabs." TextWrapping="Wrap" FontSize="12" Foreground="#607086" Margin="0,0,0,12"/>
<CheckBox x:Name="MicAudio" Content="Record my microphone" IsChecked="True"/>
<ComboBox x:Name="MicPicker" DisplayMemberPath="FriendlyName"/>
<TextBlock Text="3   SAVE" FontWeight="Bold" Foreground="#51647A" Margin="0,8,0,6"/>
<TextBlock Text="Meeting name" Foreground="#607086"/>
<TextBox x:Name="MeetingName" Text="My meeting" Padding="9" Margin="0,5,0,12"/>
<TextBlock Text="1080p MP4 • H.264 + AAC • 30 fps" FontSize="12" Foreground="#607086" Margin="0,0,0,8"/>
<TextBlock x:Name="FolderLabel" TextWrapping="Wrap" FontSize="12" Foreground="#607086"/>
<TextBlock Text="Keep the meeting window open and unminimized. A colored border indicates capture." TextWrapping="Wrap" FontSize="12" Foreground="#607086" Margin="0,18,0,0"/>
</StackPanel></ScrollViewer>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="145"/></Grid.RowDefinitions>
<Border Background="#101B2B" CornerRadius="10" ClipToBounds="True"><Grid><TextBlock x:Name="Placeholder" Text="Your recording will appear here" Foreground="#AABBD0" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Preview" Stretch="Uniform" Visibility="Collapsed"/><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" Visibility="Collapsed"/></Grid></Border>
<StackPanel Grid.Row="1" Margin="0,12,0,18"><Slider x:Name="Seek" Minimum="0" Maximum="1" IsEnabled="False"/><DockPanel Margin="0,6,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="Play" Content="Play" IsEnabled="False"/><Button x:Name="PausePlayback" Content="Pause" IsEnabled="False"/><Button x:Name="OpenFolder" Content="Open folder"/></StackPanel><TextBlock x:Name="PlaybackTime" Text="00:00 / 00:00" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#607086"/></DockPanel></StackPanel>
<DockPanel Grid.Row="2"><TextBlock DockPanel.Dock="Top" Text="SAVED RECORDINGS  ·  Double-click to play" FontSize="12" FontWeight="Bold" Foreground="#51647A" Margin="0,0,0,8"/><ListBox x:Name="Library" DisplayMemberPath="Label" BorderBrush="#D8E0E8" Background="White"/></DockPanel>
</Grid></Grid>
<StackPanel Grid.Row="2" Margin="0,22,0,0"><Border Background="#E6EDF5" Padding="12" CornerRadius="6" Margin="0,0,0,14"><TextBlock x:Name="Status" Text="Choose your meeting window to get started." TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal"><Button x:Name="Record" Content="Start recording" Background="#176C61" Foreground="White" FontWeight="SemiBold"/><Button x:Name="PauseRecord" Content="Pause recording" IsEnabled="False"/><Button x:Name="StopRecord" Content="Stop and save" IsEnabled="False"/></StackPanel></StackPanel>
</Grid></Window>